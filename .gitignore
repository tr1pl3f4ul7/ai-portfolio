# ---------------------------------------------------------------------------
# Secrets — never commit. See docs/runbook.md for where these actually live.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/nginx/*.key.example
id_rsa
id_ed25519
*.p12
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Vector store / embeddings artefacts (regenerated by the ingestion script)
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/index/

# Transient output from the container test runners (backend and infra).
backend/test/*.log
infra/test/*.log

# ---------------------------------------------------------------------------
# Node / web / edge
# ---------------------------------------------------------------------------
node_modules/
.wrangler/
.dev.vars
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
web/dist/
edge/dist/
.vitest/

# ---------------------------------------------------------------------------
# Editors / OS / tooling
# ---------------------------------------------------------------------------
.claude/settings.local.json
# Written by `docker mcp client connect`. Hardcodes Windows-specific paths and
# points at a local Docker MCP profile, so it is machine-specific rather than
# shared config. Recreate it with the commands in CLAUDE.md.
.mcp.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
