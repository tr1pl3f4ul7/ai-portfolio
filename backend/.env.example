# Shape reference for backend/.env — dummy values only, never the real thing.
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# On the Oracle VM these come from the systemd unit's Environment= directives,
# and in CI from GitHub Actions secrets. There is no .env file in either place.
#
# Everything the backend can be configured with is listed in app/config.py, and
# everything except the key below has a working default. Only override one of
# those if you have a reason to.

# Required. Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME

# Optional. Uncomment to override the defaults in app/config.py.
#AI_PORTFOLIO_ANTHROPIC_MODEL=claude-haiku-4-5
#AI_PORTFOLIO_CHAT_LIMIT_PER_IP=20
#AI_PORTFOLIO_CHAT_LIMIT_TOTAL=500
