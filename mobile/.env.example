# Shape reference for mobile/.env — dummy values only, never the real thing.
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read via --dart-define-from-file=.env (Flutter's own KEY=VALUE .env
# support), which populates String.fromEnvironment in lib/observability.dart
# and lib/analytics.dart. There is no other loading mechanism — nothing here
# is read automatically just by the file existing.
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#   flutter build ipa --release --dart-define-from-file=.env
#
# In CI (once Step 7.5 builds the mobile pipeline) these come from GitHub
# Actions secrets instead, written to a generated .env or passed as
# individual --dart-define flags — there is no .env file in CI.

# Error tracking. Leave unset locally if you don't want dev-machine noise in
# Sentry — off without a DSN, same as backend/web. Create at
# https://sentry.io, add a new project with platform "Flutter" (a separate
# project from the backend and web ones, since they're different runtimes).
# Get the DSN from that project's Settings → Client Keys (DSN).
#SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Analytics. Off without a key, same as web. Get the key from PostHog →
# Project Settings → Project API Key (starts with phc_). Reuses the same
# project as web unless a separate one was created for mobile — either way,
# it must be a real PostHog project token, not the Sentry DSN.
#POSTHOG_KEY=phc_REPLACE_ME
#POSTHOG_HOST=https://us.i.posthog.com
