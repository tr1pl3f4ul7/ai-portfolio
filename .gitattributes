# Normalise line endings so a Windows dev machine can't ship CRLF to a Linux VM.
* text=auto eol=lf

# Files that MUST be LF — CRLF breaks the shebang / interpreter on Linux.
*.sh            text eol=lf
*.bash          text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
infra/**        text eol=lf

# Windows-only files keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.pdf           binary
*.zip           binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary
*.jks           binary
*.keystore      binary
